@using System.Linq;
@using DotNetInterview.Web.ViewModels.Interviews;

<h5>@Title</h5>
<div class="form-group">
    <div class="form-group">
        <label class="control-label required">Question</label>
        <InputText @bind-Value=Question.Content class="form-control" />
    </div>
    <div class="form-group">
        <label class="control-label">Given answer (Optional)</label>
        <InputText @bind-Value=Question.GivenAnswer class="form-control" />
    </div>
    <div>
        <div class="form-check form-check-inline">
            <p>You can rank this question as most:</p>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input interesting"
                   type="checkbox"
                   @bind="Question.IsInteresting" />
            <label class="form-check-label">interesting</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input unexpected"
                   type="checkbox"
                   @bind="Question.IsUnexpected">
            <label class="form-check-label">unexpected</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input difficult"
                   type="checkbox"
                   @bind="Question.IsDifficult">
            <label class="form-check-label">difficult</label>
        </div>
    </div>
</div>