@using System.Linq;
@using DotNetInterview.Web.ViewModels.Interviews;

<h5>@Title</h5>
<div class="form-group">
    <div class="form-group">
        <label class="control-label required">Question</label>
        <InputText @bind-Value=Question.Content class="form-control" />
    </div>
    <div class="form-group">
        <label class="control-label">Given answer (Optional)</label>
        <InputText @bind-Value=Question.GivenAnswer class="form-control" />
    </div>
    <div class="form-group inner-form">
        <p>You can rank this question as most:</p>
        <div class="form-check form-check-inline">
            <input type="radio" name="questionRank" checked="@(Question.SelectedRank == "Interesting")" @onclick=@(() => HandleInputRadioChange("Interesting")) />
            <label class="form-check-label" for="interesting">Interesting</label>
        </div>
        <div class="form-check form-check-inline">
            <input type="radio" name="questionRank" checked="@(Question.SelectedRank == "Unexpected")" @onclick=@(() => HandleInputRadioChange("Unexpected")) />
            <label class="form-check-label" for="unexpected">Unexpected</label>
        </div>
        <div class="form-check form-check-inline">
            <input type="radio" name="questionRank" checked="@(Question.SelectedRank == "Difficult")" @onclick=@(() => HandleInputRadioChange("Difficult")) />
            <label class="form-check-label" for="difficult">Difficult</label>
        </div>
    </div>

</div>